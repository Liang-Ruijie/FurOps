{
  "name": "furops-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-reporter=tap",
    "migrate": "node src/domain/migrate.ts",
    "typecheck": "tsc --noEmit",
    "start": "node ../scripts/start.mjs",
    "start:server": "node --env-file-if-exists=.env src/server/index.ts",
    "start:worker": "node --env-file-if-exists=.env src/worker/index.ts"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
